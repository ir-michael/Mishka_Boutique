rules_version = '2';

// À utiliser UNIQUEMENT si MEDIA.provider = "firebase" dans js/config.js
// Publier dans Firebase > Storage > Règles
service firebase.storage {
  match /b/{bucket}/o {
    match /chat/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
